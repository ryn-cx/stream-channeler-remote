{
  "manifest_version": 2,
  "name": "Stream Channeler Remote",
  "version": "0.0.0",
  "permissions": ["storage", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["gm.js", "userscript.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [],
      "js": ["gm.js", "userscript.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stream-channeler-remote@ryn-cx"
    }
  }
}
